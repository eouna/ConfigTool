<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<AnchorPane fx:id="root" styleClass="transparent-root horse-lamp-root"
            prefHeight="990.0" prefWidth="1040.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.eouna.configtool.ui.controllers.HorseRaceLampController">
    <children>
        <BorderPane prefHeight="990.0" prefWidth="1040.0">
            <center>
                <StackPane prefHeight="970.0" prefWidth="1000.0"
                           BorderPane.alignment="CENTER"/>
            </center>
            <top>
                <HBox fx:id="top" prefHeight="20.0" prefWidth="1040.0"
                      BorderPane.alignment="CENTER"/>
            </top>
            <bottom>
                <HBox fx:id="bottom" alignment="CENTER_RIGHT" prefHeight="20.0"
                      prefWidth="1040.0" BorderPane.alignment="CENTER"/>
            </bottom>
            <left>
                <VBox fx:id="left" alignment="BOTTOM_CENTER" prefHeight="970.0"
                      prefWidth="20.0" BorderPane.alignment="CENTER"/>
            </left>
            <right>
                <VBox fx:id="right" prefHeight="970.0" prefWidth="20.0"
                      BorderPane.alignment="CENTER"/>
            </right>
        </BorderPane>
    </children>
</AnchorPane>
