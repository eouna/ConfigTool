<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<AnchorPane styleClass="search-root" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1" minHeight="200.0" prefWidth="600.0"
            fx:controller="com.eouna.configtool.ui.controllers.ExcelSearchController">
    <VBox styleClass="search-surface" AnchorPane.topAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0" spacing="8.0">
        <HBox alignment="CENTER" minHeight="40.0" spacing="8.0">
            <TextField prefWidth="520.0" HBox.hgrow="ALWAYS"/>
            <Button text="搜索" prefWidth="80.0" onAction="#searchExcelFieldData"
                    styleClass="primary">
                <graphic>
                    <FontIcon iconLiteral="fa-search"/>
                </graphic>
                <font>
                    <Font size="12.0"/>
                </font>
            </Button>
        </HBox>
        <TextArea fx:id="searchResShowArea" disable="true" VBox.vgrow="ALWAYS"
                  style="-fx-font-size: 14px"/>
    </VBox>
</AnchorPane>
