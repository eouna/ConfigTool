<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<AnchorPane styleClass="about-root" prefHeight="150.0" prefWidth="320.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.eouna.configtool.ui.controllers.AboutController">
    <VBox styleClass="about-card" alignment="CENTER" prefHeight="118.0" prefWidth="288.0"
          spacing="6.0" AnchorPane.topAnchor="16.0" AnchorPane.rightAnchor="16.0"
          AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="16.0">
        <HBox alignment="CENTER">
            <Label text="作者">
                <font>
                    <Font size="15.0"/>
                </font>
            </Label>
            <Label text="：">
                <font>
                    <Font size="15.0"/>
                </font>
            </Label>
            <Label fx:id="authorName" styleClass="author-link" alignment="CENTER"
                   onMouseClicked="#onAuthorClicked" text="CCL">
                <font>
                    <Font size="15.0"/>
                </font>
            </Label>
        </HBox>
        <HBox alignment="CENTER">
            <Label text="版本">
                <font>
                    <Font size="15.0"/>
                </font>
            </Label>
            <Label text="：">
                <font>
                    <Font size="15.0"/>
                </font>
            </Label>
            <Label fx:id="versionId" alignment="CENTER" text="V_0.1">
                <font>
                    <Font size="15.0"/>
                </font>
            </Label>
        </HBox>
        <HBox alignment="CENTER">
            <Label fx:id="powerName" alignment="CENTER" text="Power By ** Company">
                <font>
                    <Font size="15.0"/>
                </font>
            </Label>
        </HBox>
        <HBox alignment="CENTER">
            <Label fx:id="copyRightName" alignment="CENTER"
                   text="Copyright © 2018–2023 **">
                <font>
                    <Font size="15.0"/>
                </font>
            </Label>
        </HBox>
    </VBox>
</AnchorPane>
