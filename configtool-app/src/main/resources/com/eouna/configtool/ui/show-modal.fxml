<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.TextFlow?>
<VBox styleClass="modal-root" alignment="CENTER" prefHeight="650.0" prefWidth="800.0"
      spacing="10.0" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eouna.configtool.ui.controllers.ShowModalController">
    <ScrollPane fx:id="scrollPane" styleClass="modal-scroll" prefHeight="580.0"
                prefWidth="772.0" VBox.vgrow="ALWAYS">
        <StackPane fx:id="stackPane" minHeight="560.0" prefWidth="760.0">
            <TextFlow fx:id="errorShowArea" styleClass="error-flow" minHeight="560.0"
                      prefWidth="748.0"/>
        </StackPane>
    </ScrollPane>
    <HBox alignment="CENTER" prefHeight="46.0">
        <Button styleClass="primary" alignment="CENTER" contentDisplay="CENTER"
                onAction="#closeWindow" prefHeight="30.0" prefWidth="100.0" text="关闭"
                textOverrun="CENTER_ELLIPSIS">
            <HBox.margin>
                <Insets top="3.0"/>
            </HBox.margin>
        </Button>
    </HBox>
</VBox>
